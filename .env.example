# Local Supabase (`npx supabase start`) or your hosted project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 temporarily to log each server-side Supabase request and duration.
SUPABASE_PERF_LOGGING=0

# Used for OAuth redirects, auth emails, and invite links in outbound email/SMS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email invitations — Gmail SMTP
# Use a Google App Password (Google Account → Security → 2-Step Verification → App passwords).
# GMAIL_FROM is optional and defaults to GMAIL_USER. Gmail only sends as that account or a verified alias.
#
# Deliverability: a free @gmail.com "noreply" address often lands in spam.
# For inbox placement, send from Google Workspace on a domain you own (e.g. invites@plated.app)
# and add SPF, DKIM, and DMARC for that domain. Avoid "noreply" in the local part.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# SMS invitations — Twilio (https://console.twilio.com)
# TWILIO_ACCOUNT_SID must start with AC (Account SID on the Console home page).
# Do not paste a phone number SID (PN...) or messaging service SID here — that returns "invalid username".
# TWILIO_AUTH_TOKEN is the Auth Token next to the Account SID (click to reveal).
# Trial accounts can only text verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional. If set, used instead of TWILIO_FROM_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID=

# OpenAI-compatible LLM — required for recipe import (parses ingredients, steps, metadata)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional PWA Web Push subscription key (URL-safe base64 public VAPID key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
